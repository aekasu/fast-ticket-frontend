# Base URL of the fast-ticket backend. Only the Next.js server talks to it; the browser never does.
FASTAPI_URL=http://localhost:8000

# Development only: hostnames or IPs, other than localhost, that other devices use to open `npm run dev`
# (comma-separated). Without this the page loads there but its scripts are refused and nothing works.
# DEV_ALLOWED_ORIGINS=192.168.1.20,laptop.local
